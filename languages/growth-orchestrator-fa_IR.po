#. translators: %s: parser or persistence error message
msgid "Rules could not be saved: %s"
msgstr "قواعد ذخیره نشدند: %s"

msgid "Rules template missing."
msgstr "الگوی صفحه قواعد یافت نشد."

msgid "SMS settings template missing."
msgstr "الگوی صفحه تنظیمات پیامک یافت نشد."

msgid "Rules database table missing or could not be created."
msgstr "جدول پایگاه‌داده قواعد وجود ندارد یا ساخته نشد."

msgid "Failed to persist rules to the database."
msgstr "ذخیره قواعد در پایگاه‌داده ناموفق بود."

msgid ""
"Rules are stored in the growth_orchestrator_rules database table. When the table is empty, "
"this editor mirrors the legacy option/plugin JSON until first save hydrates persistence."
msgstr ""
"قواعد در جدول پایگاه‌داده growth_orchestrator_rules ذخیره می‌شوند. اگر جدول خالی باشد، این "
"ویرایشگر تا زمان اولین ذخیرهٔ موفق، مانند گزینهٔ قدیمی افزونه یا پروندهٔ JSON رفتار می‌کند."

msgid "JSON error (preview only; saved value unchanged):"
msgstr "خطای JSON (فقط پیش‌نمایش؛ مقدار ذخیره‌شده بدون تغییر است):"

msgid "Fix the JSON below and save again."
msgstr "JSON زیر را اصلاح کنید و دوباره ذخیره کنید."

msgid "Rules overview"
msgstr "مرور قواعد"

