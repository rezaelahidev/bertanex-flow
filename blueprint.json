{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Bertanex Flow",
    "description": "Loads the latest commit from the default branch."
  },
  "landingPage": "/wp-admin/admin.php?page=bertanex-flow",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "fa_IR"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Bertanex Flow"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/rezaelahidev/bertanex-flow",
        "ref": "HEAD"
      },
      "options": {
        "activate": true,
        "targetFolderName": "bertanex-flow"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; update_option('woocommerce_coming_soon', 'no'); update_option('woocommerce_task_list_hidden', 'yes'); delete_transient('_wc_activation_redirect'); ?>"
    }
  ]
}
