{
  "version": "1.0.0",
  "rules": [
    {
      "id": "wp_welcome_user",
      "label": "خوش‌آمد به کاربر تازه وردپرس",
      "enabled": true,
      "priority": 10,
      "trigger": { "events": ["USER_REGISTERED"] },
      "conditions": { "all": [{ "field": "user_id", "op": "gte", "value": 1 }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "به {site_name} خوش آمدید",
            "message": "حساب شما آماده است. هر زمان می‌توانید وارد شوید."
          }
        }
      ]
    },
    {
      "id": "wp_comment_author",
      "label": "ایمیل به نویسنده دیدگاه",
      "enabled": false,
      "priority": 20,
      "trigger": { "events": ["COMMENT_POSTED"] },
      "conditions": { "all": [{ "field": "user_id", "op": "gte", "value": 1 }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "دیدگاه شما دریافت شد",
            "message": "از دیدگاه شما در {site_name} سپاسگزاریم."
          }
        }
      ]
    },
    {
      "id": "wp_post_published",
      "label": "ایمیل به نویسنده هنگام انتشار نوشته",
      "enabled": false,
      "priority": 30,
      "trigger": { "events": ["POST_PUBLISHED"] },
      "conditions": { "all": [{ "field": "post_status", "op": "eq", "value": "publish" }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "نوشته شما منتشر شد",
            "message": "نوشته شما اکنون در {site_name} منتشر شده است."
          }
        }
      ]
    },
    {
      "id": "wp_password_changed",
      "label": "ایمیل به کاربر پس از تغییر گذرواژه",
      "enabled": false,
      "priority": 40,
      "trigger": { "events": ["PASSWORD_CHANGED"] },
      "conditions": { "all": [{ "field": "user_id", "op": "gte", "value": 1 }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "گذرواژه شما تغییر کرد",
            "message": "گذرواژه حساب {site_name} شما تغییر کرد. اگر این کار را شما نکرده‌اید، آن را بازنشانی کنید."
          }
        }
      ]
    },
    {
      "id": "woo_order_completed",
      "label": "تشکر از مشتری هنگام تکمیل سفارش",
      "enabled": true,
      "priority": 50,
      "trigger": { "events": ["woocommerce.order.completed"] },
      "conditions": { "all": [{ "field": "order.status", "op": "eq", "value": "completed" }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "سفارش شما تکمیل شد",
            "message": "از سفارش شما سپاسگزاریم. سفارش اکنون تکمیل شده است."
          }
        }
      ]
    },
    {
      "id": "woo_order_processing",
      "label": "ایمیل به مشتری هنگام پردازش سفارش",
      "enabled": false,
      "priority": 60,
      "trigger": { "events": ["woocommerce.order.status_changed"] },
      "conditions": { "all": [{ "field": "order.status", "op": "eq", "value": "processing" }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "سفارش شما در حال پردازش است",
            "message": "در حال آماده‌سازی سفارش شما هستیم."
          }
        }
      ]
    },
    {
      "id": "woo_order_paid",
      "label": "ایمیل به مشتری هنگام پرداخت سفارش",
      "enabled": false,
      "priority": 70,
      "trigger": { "events": ["woocommerce.order.paid"] },
      "conditions": { "all": [{ "field": "user_id", "op": "gte", "value": 1 }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "پرداخت دریافت شد",
            "message": "پرداخت شما دریافت شد. سپاسگزاریم."
          }
        }
      ]
    },
    {
      "id": "woo_customer_created",
      "label": "خوش‌آمد به مشتری تازه ووکامرس",
      "enabled": false,
      "priority": 80,
      "trigger": { "events": ["woocommerce.customer.created"] },
      "conditions": { "all": [{ "field": "user_role", "op": "eq", "value": "customer" }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "به {site_name} خوش آمدید",
            "message": "حساب مشتری شما آماده است."
          }
        }
      ]
    },
    {
      "id": "woo_order_refunded",
      "label": "ایمیل به مشتری هنگام بازپرداخت سفارش",
      "enabled": true,
      "priority": 90,
      "trigger": { "events": ["woocommerce.refund.created"] },
      "conditions": { "all": [{ "field": "user_id", "op": "gte", "value": 1 }] },
      "actions": [
        {
          "type": "send_email",
          "template_id": "wordpress",
          "params": {
            "subject": "بازپرداخت شما",
            "message": "برای سفارش شما بازپرداخت ثبت شد."
          }
        }
      ]
    }
  ]
}
