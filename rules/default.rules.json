    {
      "id": "sms_complete_profile_day1_welcome",
      "label": "Complete profile day 1 — welcome (5 min after registration)",
      "enabled": true,
      "priority": 10,
      "trigger": {
        "events": [
          "USER_REGISTERED"
        ]
      },
      "conditions": {
        "all": [
          {
            "field": "profile_completed",
            "op": "eq",
            "value": false
          }
        ]
      },
      "actions": [
        {
          "type": "send_sms",
          "template_id": "complete_profile_day1_welcome",
          "delay_seconds": 300,
          "params": {
            "_delay": {
              "active": true,
              "dateMode": "today",
              "days": 0,
              "customDate": "",
              "timeMode": "minutes",
              "relativeAmount": 5,
              "customTime": ""
            }
          }
        }
      ]
    },
